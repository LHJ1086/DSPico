diff --git a/src/pio_usb_host.c b/src/pio_usb_host.c
index 7c18e5f..9bc35a4 100644
--- a/src/pio_usb_host.c
+++ b/src/pio_usb_host.c
@@ -585,6 +585,21 @@ static int __no_inline_not_in_flash_func(usb_out_transaction)(pio_port_t *pp,
 
   uint16_t const xact_len = pio_usb_ll_get_transaction_len(ep);
 
+  if ((ep->attr & 0x03) == EP_ATTR_ISOCHRONOUS) {
+    // Isochronous transactions have no handshake phase (USB 2.0 sec 8.5.5):
+    // send the token + data and complete immediately instead of waiting for
+    // an ACK that will never arrive. Full-speed isochronous always uses
+    // DATA0, so undo the data-toggle done by pio_usb_ll_transfer_continue().
+    // Callers must submit at most wMaxPacketSize per transfer (one
+    // transaction per frame), which the TinyUSB hcd glue already does.
+    pio_usb_bus_send_token(pp, USB_PID_OUT, ep->dev_addr, ep->ep_num);
+    pio_usb_bus_usb_transfer(pp, ep->buffer, ep->encoded_data_len);
+    pio_usb_ll_transfer_continue(ep, xact_len);
+    ep->data_id = 0;
+    ep->failed_count = 0;
+    return 0;
+  }
+
   pio_usb_bus_prepare_receive(pp);
   pio_usb_bus_send_token(pp, USB_PID_OUT, ep->dev_addr, ep->ep_num);
 
